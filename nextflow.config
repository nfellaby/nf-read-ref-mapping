params {
    input            = null
    outdir           = 'results'
    publish_dir_mode = 'copy'

    // minimap2 presets per platform
    preset_illumina  = 'sr'
    preset_ont       = 'map-ont'

    // Summary
    window_size      = 1000000   // bin size for read distribution along each reference
    min_mapq         = 20        // threshold reported as "MAPQ >= x"
    top_contigs      = 25        // contigs listed per sample in the HTML report

    save_bam         = true

    trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

process {
    shell         = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2

    resourceLimits = [ cpus: 16, memory: 64.GB, time: 24.h ]

    withLabel: process_single {
        cpus   = 1
        memory = { 2.GB  * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel: process_medium {
        cpus   = 8
        memory = { 8.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel: process_high {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
}

executor {
    queueSize = 50
}

profiles {

    apptainer {
        apptainer {
            enabled = true
            autoMounts = true
            cacheDir = "${projectDir}/.apptainer"
        }
    }

    slurm {
        process.executor = "slurm"
        process.queue = "htc"
    }

    conda {
        conda.enabled = true
    }
    mamba {
        conda.enabled  = true
        conda.useMamba = true
    }
    docker {
        docker.enabled = true
        wave.enabled   = true
        wave.strategy  = 'conda'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        wave.enabled           = true
        wave.strategy          = 'conda'
        wave.freeze            = true
    }
}

includeConfig 'conf/modules.config'

manifest {
    name            = 'read-ref-mapping'
    description     = 'Maps Illumina and/or ONT reads to a per-sample reference with minimap2'
    nextflowVersion = '>=24.04.0'
    mainScript      = 'main.nf'
}
