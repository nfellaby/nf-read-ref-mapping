process {

    publishDir = [
        path:   { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode:   params.publish_dir_mode,
        saveAs: { filename -> filename == 'versions.yml' ? null : filename }
    ]

    withName: '.*:MINIMAP2_INDEX' {
        publishDir = [ enabled: false ]
    }

    withName: '.*:MINIMAP2_ALIGN' {
        // Extra minimap2 options, e.g. '--secondary=no'
        ext.args   = ''
        publishDir = [
            path:    { "${params.outdir}/alignments/${meta.platform}" },
            mode:    params.publish_dir_mode,
            enabled: params.save_bam,
            saveAs:  { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: '.*:BAM_STATS' {
        publishDir = [
            path:   { "${params.outdir}/stats/${meta.platform}" },
            mode:   params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: '.*:SUMMARISE_MAPPING' {
        publishDir = [
            path:   { params.outdir },
            mode:   params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }
}
